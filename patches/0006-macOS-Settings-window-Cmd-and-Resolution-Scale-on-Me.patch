+/*
+ * apple_menu.h -- the macOS menu bar's Settings... item and its window
+ * (apple_menu.m). Mac only; both run on the main thread.
+ */
+#ifndef APPLE_MENU_H
+#define APPLE_MENU_H
+
+#include <SDL.h>
+
+/* settings.ini (the working directory) as environment defaults: fullscreen=
+ * -> NFSU2_FULLSCREEN, fps= -> NFSU2_FPS_CAP. Variables already set win.
+ * Before the window is made and the game starts. */
+void apple_settings_load(void);
+
+/* NFS Underground > Settings... (Cmd+,) in the menu bar SDL made. */
+void apple_menu_install(SDL_Window *win);
+
+#endif
diff --git a/src/apple/apple_menu.m b/src/apple/apple_menu.m
new file mode 100644
index 0000000..0c94784
--- /dev/null
+++ b/src/apple/apple_menu.m
@@ -0,0 +1,241 @@
+/*
+ * apple_menu.m -- Settings... (Cmd+,) in the app menu and its window.
+ *
+ * SDL makes the menu bar (app menu with Quit, Cmd+Q; Window menu); this adds
+ * Settings... to the app menu. The window has the port's Mac settings:
+ *
+ *   Display           Window / Full Screen     now, and at the next start
+ *   Frame Rate        60 fps / 30 fps           at the next start (NFSU2_FPS_CAP)
+ *   Resolution Scale  1x .. 2.5x                now: the same value as the
+ *                     game's Options > Camera > Resolution Scale row
+ *                     (recomp_manual.c, saved in nfsu1x_options.txt)
+ *
+ * Display and Frame Rate are kept in settings.ini in the working directory
+ * (the player folder) and become environment defaults at start
+ * (apple_settings_load); a variable set by hand still wins. F11 switches
+ * the window for this run only.
+ */
+#import <Cocoa/Cocoa.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "apple_menu.h"
+
+#define SETTINGS_FILE "settings.ini"
+
+#if defined(NFSU2_METAL) || defined(NFSU2_VULKAN)
+int nfsu1_options_scale(void);              /* recomp_manual.c */
+void nfsu1_options_set_scale(int pct);
+#  define HAVE_SCALE 1
+#endif
+
+static SDL_Window *s_win;
+static int s_fullscreen = 1;                /* settings.ini: fullscreen= */
+static int s_fps = 60;                      /* settings.ini: fps= (60 or 30) */
+
+static void settings_save(void)
+{
+    FILE *f = fopen(SETTINGS_FILE, "w");
+    if (!f) {
+        fprintf(stderr, "[settings] cannot write " SETTINGS_FILE "\n");
+        return;
+    }
+    fprintf(f, "; NFS Underground: the Mac settings (NFS Underground > Settings...)\n"
+               "fullscreen=%d\nfps=%d\n", s_fullscreen, s_fps);
+    fclose(f);
+}
+
+void apple_settings_load(void)
+{
+    char line[128];
+    FILE *f = fopen(SETTINGS_FILE, "r");
+
+    if (f) {
+        while (fgets(line, sizeof line, f)) {
+            if (!strncmp(line, "fullscreen=", 11))
+                s_fullscreen = line[11] != '0';
+            else if (!strncmp(line, "fps=", 4))
+                s_fps = atoi(line + 4) == 30 ? 30 : 60;
+        }
+        fclose(f);
+    }
+    setenv("NFSU2_FULLSCREEN", s_fullscreen ? "1" : "0", 0);
+    setenv("NFSU2_FPS_CAP", s_fps == 30 ? "30" : "60", 0);
+    fprintf(stderr, "[settings] display %s, frame rate %s\n",
+            strcmp(getenv("NFSU2_FULLSCREEN"), "0") ? "full screen" : "window",
+            atoi(getenv("NFSU2_FPS_CAP")) == 30 ? "30 fps" : "60 fps");
+}
+
+static int window_is_fullscreen(void)
+{
+    return s_win && (SDL_GetWindowFlags(s_win) & SDL_WINDOW_FULLSCREEN_DESKTOP) != 0;
+}
+
+#ifdef HAVE_SCALE
+static const int k_scale_pct[] = { 100, 150, 200, 250 };
+#endif
+
+@interface NFSSettings : NSObject <NSWindowDelegate>
+@property (strong) NSPanel *panel;
+@property (strong) NSPopUpButton *display, *fps, *scale;
+@end
+
+@implementation NFSSettings
+
+static NSTextField *label(NSString *s)
+{
+    NSTextField *t = [NSTextField labelWithString:s];
+    t.alignment = NSTextAlignmentRight;
+    return t;
+}
+
+static NSTextField *note(NSString *s)
+{
+    NSTextField *t = [NSTextField wrappingLabelWithString:s];
+    t.font = [NSFont systemFontOfSize:NSFont.smallSystemFontSize];
+    t.textColor = NSColor.secondaryLabelColor;
+    return t;
+}
+
+- (NSPopUpButton *)popup:(NSArray<NSString *> *)items action:(SEL)action
+{
+    NSPopUpButton *p = [[NSPopUpButton alloc] initWithFrame:NSZeroRect pullsDown:NO];
+    [p addItemsWithTitles:items];
+    p.target = self;
+    p.action = action;
+    return p;
+}
+
+- (void)build
+{
+    NSMutableArray<NSArray<NSView *> *> *rows = [NSMutableArray array];
+
+    self.display = [self popup:@[ @"Window", @"Full Screen" ] action:@selector(displayChanged:)];
+    self.fps = [self popup:@[ @"60 fps", @"30 fps (the original)" ] action:@selector(fpsChanged:)];
+    [rows addObject:@[ label(@"Display:"), self.display ]];
+    [rows addObject:@[ label(@"Frame Rate:"), self.fps ]];
+    [rows addObject:@[ [NSGridCell emptyContentView], note(@"Frame rate changes at the next start.") ]];
+#ifdef HAVE_SCALE
+    self.scale = [self popup:@[ @"1x (640 × 480)", @"1.5x (960 × 720)", @"2x (1280 × 960)",
+                                @"2.5x (1600 × 1200)" ]
+                      action:@selector(scaleChanged:)];
+    [rows addObject:@[ label(@"Resolution Scale:"), self.scale ]];
+    [rows addObject:@[ [NSGridCell emptyContentView],
+                       note(@"Also in the game: Options > Camera > Resolution Scale.") ]];
+#endif
+    NSGridView *grid = [NSGridView gridViewWithViews:rows];
+    grid.rowSpacing = 10;
+    grid.columnSpacing = 8;
+    [grid columnAtIndex:0].xPlacement = NSGridCellPlacementTrailing;
+    for (NSInteger r = 0; r < grid.numberOfRows; r++)
+        [grid rowAtIndex:r].yPlacement = NSGridCellPlacementCenter;
+    grid.translatesAutoresizingMaskIntoConstraints = NO;
+
+    self.panel = [[NSPanel alloc] initWithContentRect:NSMakeRect(0, 0, 420, 200)
+                                            styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable
+                                              backing:NSBackingStoreBuffered
+                                                defer:NO];
+    self.panel.title = @"Settings";
+    self.panel.releasedWhenClosed = NO;
+    self.panel.hidesOnDeactivate = NO;
+    self.panel.floatingPanel = YES;
+    /* over the game in its full-screen space too */
+    self.panel.collectionBehavior = NSWindowCollectionBehaviorFullScreenAuxiliary |
+                                    NSWindowCollectionBehaviorMoveToActiveSpace;
+    self.panel.delegate = self;
+    [self.panel.contentView addSubview:grid];
+    [NSLayoutConstraint activateConstraints:@[
+        [grid.leadingAnchor constraintEqualToAnchor:self.panel.contentView.leadingAnchor constant:20],
+        [grid.trailingAnchor constraintEqualToAnchor:self.panel.contentView.trailingAnchor constant:-20],
+        [grid.topAnchor constraintEqualToAnchor:self.panel.contentView.topAnchor constant:20],
+        [grid.bottomAnchor constraintEqualToAnchor:self.panel.contentView.bottomAnchor constant:-20],
+    ]];
+}
+
+- (void)show:(id)sender
+{
+    if (!self.panel)
+        [self build];
+    [self.display selectItemAtIndex:window_is_fullscreen() ? 1 : 0];
+    [self.fps selectItemAtIndex:s_fps == 30 ? 1 : 0];
+#ifdef HAVE_SCALE
+    for (int i = 0; i < 4; i++)
+        if (k_scale_pct[i] == nfsu1_options_scale())
+            [self.scale selectItemAtIndex:i];
+#endif
+    fprintf(stderr, "[settings] window shown\n");
+    [self.panel center];
+    [self.panel makeKeyAndOrderFront:nil];
+    [NSApp activateIgnoringOtherApps:YES];
+}
+
+- (void)displayChanged:(NSPopUpButton *)p
+{
+    s_fullscreen = p.indexOfSelectedItem == 1;
+    settings_save();
+    if (s_win)
+        SDL_SetWindowFullscreen(s_win, s_fullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+    [self.panel makeKeyAndOrderFront:nil];  /* the space may have changed */
+}
+
+- (void)fpsChanged:(NSPopUpButton *)p
+{
+    s_fps = p.indexOfSelectedItem == 1 ? 30 : 60;
+    settings_save();
+}
+
+- (void)scaleChanged:(NSPopUpButton *)p
+{
+#ifdef HAVE_SCALE
+    nfsu1_options_set_scale(k_scale_pct[p.indexOfSelectedItem]);
+#endif
+}
+
+@end
+
+static NFSSettings *s_settings;
+
+void apple_menu_install(SDL_Window *win)
+{
+    NSMenu *app = NSApp.mainMenu.itemArray.firstObject.submenu;
+    NSMenuItem *item;
+    NSInteger at = 0;
+
+    s_win = win;
+    if (!app) {
+        fprintf(stderr, "[settings] no app menu: Settings... not added\n");
+        return;
+    }
+    s_settings = [NFSSettings new];
+    /* SDL's menu already has a Settings... (Preferences...) item that does
+     * nothing; take it over rather than add a second one. */
+    item = nil;
+    for (NSMenuItem *m in app.itemArray)
+        if ([m.keyEquivalent isEqualToString:@","] || [m.title hasPrefix:@"Settings"] ||
+            [m.title hasPrefix:@"Preferences"]) {
+            item = m;
+            break;
+        }
+    if (!item) {
+        /* after "About ..." and its separator, where macOS apps keep it */
+        if (app.numberOfItems > 1 && [app itemAtIndex:1].isSeparatorItem)
+            at = 2;
+        item = [[NSMenuItem alloc] initWithTitle:@"Settings…" action:NULL keyEquivalent:@","];
+        [app insertItem:item atIndex:at];
+        [app insertItem:[NSMenuItem separatorItem] atIndex:at + 1];
+    }
+    item.title = @"Settings…";
+    item.keyEquivalent = @",";
+    item.keyEquivalentModifierMask = NSEventModifierFlagCommand;
+    item.action = @selector(show:);
+    item.target = s_settings;
+    item.enabled = YES;
+    {
+        NSMutableString *items = [NSMutableString string];
+        for (NSMenuItem *m in app.itemArray)
+            if (!m.isSeparatorItem)
+                [items appendFormat:@"%@%@%@", items.length ? @", " : @"", m.title,
+                                    m.keyEquivalent.length ? [@" ⌘" stringByAppendingString:m.keyEquivalent] : @""];
+        fprintf(stderr, "[settings] app menu: %s\n", items.UTF8String);
+    }
+}
