+#ifdef NFSU1_SCALE
+/* The Mac Settings window (src/apple/apple_menu.m): the same value as the
+ * Resolution Scale row, saved the same way. Percent, one of s_scale_pct. */
+int nfsu1_options_scale(void)
+{
+    return s_scale_pct[s_scale_idx];
+}
+
+void nfsu1_options_set_scale(int pct)
+{
+    int i;
+
+    for (i = 0; i < 4; i++)
+        if (s_scale_pct[i] == pct && (i != s_scale_idx || !s_scale_saved)) {
+            s_scale_idx = i;
+            scale_changed();
+            options_save();
+            options_log();
+        }
+}
+#endif
