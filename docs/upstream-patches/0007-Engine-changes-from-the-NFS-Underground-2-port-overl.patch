+/* Mac default: a screen narrower than 16:9 (16:10) is filled to its height
+ * and the picture's sides are cut (nothing stretched, no bars).
+ * NFSU2_SCREEN=fit letterboxes, =fill stretches. */
+static inline int xbox_apple_screen_crop(void)
+{
+    static int crop = -1;
+    if (crop < 0) {
+        const char *e = getenv("NFSU2_SCREEN");
+        crop = e ? !strcmp(e, "crop") : !TARGET_OS_IPHONE;
+    }
+    return crop;
+}
