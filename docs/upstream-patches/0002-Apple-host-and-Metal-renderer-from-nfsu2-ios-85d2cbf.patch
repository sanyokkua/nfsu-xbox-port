diff --git a/src/apple/apple_keyboard.c b/src/apple/apple_keyboard.c
new file mode 100644
index 0000000..87bcf0d
--- /dev/null
+++ b/src/apple/apple_keyboard.c
@@ -0,0 +1,185 @@
+/*
+ * apple_keyboard.c -- the Mac keyboard as an Xbox controller.
+ *
+ * Like the iPhone's touch controls (src/ios/ios_touch.m), the keyboard drives
+ * a virtual SDL game controller (SDL_JoystickAttachVirtualEx), so the title
+ * reads it through xinput_device.c like any pad and no shared code changes.
+ * It is attached while no physical controller is connected and detached when
+ * one is, so a real pad always gets port 0. NFSU2_KEYBOARD=0 turns it off.
+ *
+ *   arrow keys    d-pad and left stick (menus, steering)
+ *   A / D         left stick left / right (steering, for WASD hands)
+ *   W / S         right / left trigger (gas / brake, reverse)
+ *   Enter         A and Start together ("press START", OK, select, pause)
+ *   Esc, Bksp     B (back)
+ *   Space         X               Left Shift   Y
+ *   Q / E         White / Black   Tab          Back
+ *   P             Start           I J K L      right stick
+ *
+ * Key events arrive on the main thread (apple_main.c's event loop); the
+ * title reads the pad state from its own thread, as with the touch pad.
+ */
+#include <TargetConditionals.h>
+#if defined(__APPLE__) && TARGET_OS_OSX
+
+#include <SDL.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static SDL_Joystick *s_pad;
+static int s_mode = -1;                  /* 0 off, 1 without a controller, 2 always */
+static Uint8 s_held[SDL_NUM_SCANCODES];
+
+enum { BTN, AXIS_NEG, AXIS_POS };
+
+static const struct {
+    SDL_Scancode key;
+    int kind, target;
+} k_map[] = {
+    { SDL_SCANCODE_UP,        BTN,      SDL_CONTROLLER_BUTTON_DPAD_UP },
+    { SDL_SCANCODE_DOWN,      BTN,      SDL_CONTROLLER_BUTTON_DPAD_DOWN },
+    { SDL_SCANCODE_LEFT,      BTN,      SDL_CONTROLLER_BUTTON_DPAD_LEFT },
+    { SDL_SCANCODE_RIGHT,     BTN,      SDL_CONTROLLER_BUTTON_DPAD_RIGHT },
+    { SDL_SCANCODE_UP,        AXIS_NEG, SDL_CONTROLLER_AXIS_LEFTY },
+    { SDL_SCANCODE_DOWN,      AXIS_POS, SDL_CONTROLLER_AXIS_LEFTY },
+    { SDL_SCANCODE_LEFT,      AXIS_NEG, SDL_CONTROLLER_AXIS_LEFTX },
+    { SDL_SCANCODE_RIGHT,     AXIS_POS, SDL_CONTROLLER_AXIS_LEFTX },
+    { SDL_SCANCODE_A,         AXIS_NEG, SDL_CONTROLLER_AXIS_LEFTX },
+    { SDL_SCANCODE_D,         AXIS_POS, SDL_CONTROLLER_AXIS_LEFTX },
+    { SDL_SCANCODE_W,         AXIS_POS, SDL_CONTROLLER_AXIS_TRIGGERRIGHT },
+    { SDL_SCANCODE_S,         AXIS_POS, SDL_CONTROLLER_AXIS_TRIGGERLEFT },
+    { SDL_SCANCODE_RETURN,    BTN,      SDL_CONTROLLER_BUTTON_A },
+    { SDL_SCANCODE_RETURN,    BTN,      SDL_CONTROLLER_BUTTON_START },
+    { SDL_SCANCODE_KP_ENTER,  BTN,      SDL_CONTROLLER_BUTTON_A },
+    { SDL_SCANCODE_KP_ENTER,  BTN,      SDL_CONTROLLER_BUTTON_START },
+    { SDL_SCANCODE_ESCAPE,    BTN,      SDL_CONTROLLER_BUTTON_B },
+    { SDL_SCANCODE_BACKSPACE, BTN,      SDL_CONTROLLER_BUTTON_B },
+    { SDL_SCANCODE_SPACE,     BTN,      SDL_CONTROLLER_BUTTON_X },
+    { SDL_SCANCODE_LSHIFT,    BTN,      SDL_CONTROLLER_BUTTON_Y },
+    /* xinput_device.c: right shoulder = White, left shoulder = Black */
+    { SDL_SCANCODE_Q,         BTN,      SDL_CONTROLLER_BUTTON_RIGHTSHOULDER },
+    { SDL_SCANCODE_E,         BTN,      SDL_CONTROLLER_BUTTON_LEFTSHOULDER },
+    { SDL_SCANCODE_TAB,       BTN,      SDL_CONTROLLER_BUTTON_BACK },
+    { SDL_SCANCODE_P,         BTN,      SDL_CONTROLLER_BUTTON_START },
+    { SDL_SCANCODE_I,         AXIS_NEG, SDL_CONTROLLER_AXIS_RIGHTY },
+    { SDL_SCANCODE_K,         AXIS_POS, SDL_CONTROLLER_AXIS_RIGHTY },
+    { SDL_SCANCODE_J,         AXIS_NEG, SDL_CONTROLLER_AXIS_RIGHTX },
+    { SDL_SCANCODE_L,         AXIS_POS, SDL_CONTROLLER_AXIS_RIGHTX },
+};
+
+static int mode(void)
+{
+    if (s_mode < 0) {
+        const char *e = getenv("NFSU2_KEYBOARD");
+        s_mode = e && *e == '0' ? 0 : e && *e == '2' ? 2 : 1;
+    }
+    return s_mode;
+}
+
+/* Every button and axis from the keys held now: a button is down while any
+ * key mapped to it is; an axis is the sum of its keys' directions. */
+static void update(void)
+{
+    int down[SDL_CONTROLLER_BUTTON_MAX] = { 0 };
+    int axis[SDL_CONTROLLER_AXIS_MAX] = { 0 };
+    size_t i;
+
+    if (!s_pad)
+        return;
+    for (i = 0; i < sizeof k_map / sizeof k_map[0]; i++) {
+        if (!s_held[k_map[i].key])
+            continue;
+        if (k_map[i].kind == BTN)
+            down[k_map[i].target] = 1;
+        else
+            axis[k_map[i].target] += k_map[i].kind == AXIS_POS ? 1 : -1;
+    }
+    for (i = 0; i < SDL_CONTROLLER_BUTTON_MAX; i++)
+        SDL_JoystickSetVirtualButton(s_pad, (int)i, down[i] ? SDL_PRESSED : SDL_RELEASED);
+    for (i = 0; i < SDL_CONTROLLER_AXIS_MAX; i++) {
+        int v = axis[i] > 0 ? 1 : axis[i] < 0 ? -1 : 0;
+        Sint16 s;
+        if (i == SDL_CONTROLLER_AXIS_TRIGGERLEFT || i == SDL_CONTROLLER_AXIS_TRIGGERRIGHT)
+            s = v > 0 ? SDL_JOYSTICK_AXIS_MAX : SDL_JOYSTICK_AXIS_MIN;   /* at rest: MIN */
+        else
+            s = v > 0 ? SDL_JOYSTICK_AXIS_MAX : v < 0 ? SDL_JOYSTICK_AXIS_MIN + 1 : 0;
+        SDL_JoystickSetVirtualAxis(s_pad, (int)i, s);
+    }
+}
+
+static void attach(void)
+{
+    SDL_VirtualJoystickDesc d;
+    int index;
+
+    if (s_pad)
+        return;
+    SDL_zero(d);
+    d.version  = SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+    d.type     = SDL_JOYSTICK_TYPE_GAMECONTROLLER;
+    d.naxes    = SDL_CONTROLLER_AXIS_MAX;
+    d.nbuttons = SDL_CONTROLLER_BUTTON_DPAD_RIGHT + 1;
+    d.name     = "Keyboard";
+    index = SDL_JoystickAttachVirtualEx(&d);
+    s_pad = index >= 0 ? SDL_JoystickOpen(index) : NULL;
+    if (!s_pad) {
+        fprintf(stderr, "[keyboard] virtual controller: %s\n", SDL_GetError());
+        return;
+    }
+    update();
+    fprintf(stderr, "[keyboard] on: arrows/WASD drive (W gas, S brake), Enter = A + Start,"
+                    " Esc = B, Space = X, Shift = Y, Q/E = White/Black, Tab = Back, P = Start\n");
+}
+
+static void detach(void)
+{
+    SDL_JoystickID id;
+    int i;
+
+    if (!s_pad)
+        return;
+    id = SDL_JoystickInstanceID(s_pad);
+    SDL_JoystickClose(s_pad);
+    s_pad = NULL;
+    for (i = 0; i < SDL_NumJoysticks(); i++)
+        if (SDL_JoystickGetDeviceInstanceID(i) == id) {
+            SDL_JoystickDetachVirtual(i);
+            break;
+        }
+    fprintf(stderr, "[keyboard] off: a controller is connected\n");
+}
+
+/* Main thread: at start and whenever a controller comes or goes. */
+void apple_keyboard_controllers_changed(void)
+{
+    int physical = 0, i;
+
+    if (!mode())
+        return;
+    for (i = 0; i < SDL_NumJoysticks(); i++)
+        if (!SDL_JoystickIsVirtual(i) && SDL_IsGameController(i))
+            physical++;
+    if (mode() == 2 || physical == 0)
+        attach();
+    else
+        detach();
+}
+
+/* Main thread: every SDL event; keys drive the pad, losing the focus lets
+ * go of everything (the key-up would go to another application). */
+void apple_keyboard_event(const SDL_Event *e)
+{
+    if (!s_pad)
+        return;
+    if (e->type == SDL_KEYDOWN || e->type == SDL_KEYUP) {
+        if (e->key.repeat)
+            return;
+        s_held[e->key.keysym.scancode] = e->type == SDL_KEYDOWN;
+        update();
+    } else if (e->type == SDL_WINDOWEVENT && e->window.event == SDL_WINDOWEVENT_FOCUS_LOST) {
+        SDL_memset(s_held, 0, sizeof s_held);
+        update();
+    }
+}
+
+#endif /* __APPLE__ && TARGET_OS_OSX */
diff --git a/src/apple/apple_main.c b/src/apple/apple_main.c
new file mode 100644
index 0000000..7db85f1
--- /dev/null
+++ b/src/apple/apple_main.c
@@ -0,0 +1,387 @@
+/*
+ * apple_main.c -- macOS host for the NFSU2 recompilation (iOS later).
+ *
+ * AppKit (and UIKit) own the main thread: windows are created there and
+ * events are pumped there. Linux runs the title on main() and lets the
+ * renderer make its window on the pushbuffer executor's thread; AppKit
+ * refuses that. So here, as on the Switch, the title runs on a 16 MB thread
+ * of its own, and the main thread makes the window, hands it to the renderer
+ * (nv2a_gl_adopt_window, the hook the Switch loading screen uses) and pumps
+ * events until the title returns.
+ *
+ * The main thread must not block anywhere but SDL_WaitEvent: SDL's Cocoa GL
+ * backend dispatch_sync()s [NSOpenGLContext update]/setView from the render
+ * thread to the main queue, which only runs while the main loop does.
+ *
+ * With NFSU2_METAL built in, the native Metal renderer (nv2a_metal) is used
+ * unless NFSU2_RENDERER=vulkan picks Vulkan/MoltenVK; its view and layer are
+ * made here on the main thread as the Vulkan surface is.
+ */
+#if defined(__APPLE__)
+
+#include <SDL.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE
+#if !defined(NFSU2_VULKAN)
+#error "iOS renders with Vulkan (MoltenVK): configure with -DNFSU2_VULKAN=ON"
+#endif
+void ios_host_setup(void);              /* src/ios/ios_host.c */
+int ios_attach_window_to_scene(SDL_Window *window);   /* src/ios/ios_scene.m */
+void ios_touch_attach(SDL_Window *window);            /* src/ios/ios_touch.m */
+void ios_touch_controllers_changed(void);
+void ios_touch_update_auto(void);
+int ios_import_game(const char *game_dir);            /* src/ios/ios_import.m */
+void ios_verify_game(const char *game_dir);
+#endif
+
+int nfsu2_game_main(void);              /* main.c */
+#if !TARGET_OS_IPHONE
+void apple_keyboard_controllers_changed(void);           /* apple_keyboard.c */
+void apple_keyboard_event(const SDL_Event *e);
+#endif
+void apple_perf_start(void);            /* apple_perf.m: [perf] lines */
+
+static SDL_Window   *s_win;
+#if !defined(NFSU2_VULKAN)
+static SDL_GLContext s_ctx;
+#endif
+static int           s_rc = 1;
+static Uint32        s_done_event;
+static int           s_metal;            /* NFSU2_RENDERER=metal */
+
+/* src/main.c: which renderer to install. */
+int nfsu2_apple_metal(void)
+{
+    return s_metal;
+}
+
+#if !defined(NFSU2_VULKAN)
+/* nv2a_gl.c: a weak default returns 0 and the renderer would create its own
+ * window on the executor thread. */
+int nv2a_gl_adopt_window(void **win, void **ctx)
+{
+    if (!s_win || !s_ctx)
+        return 0;
+    *win = s_win;
+    *ctx = s_ctx;
+    return 1;
+}
+#else
+#include <SDL_vulkan.h>
+#include <dispatch/dispatch.h>
+
+/* nv2a_vk.c: the window, and its surface made on the main thread (SDL adds
+ * a Metal view to the window for it). The renderer asks from its own thread;
+ * the main thread serves the main queue while it waits for events. */
+int nv2a_vk_adopt_window(void **win)
+{
+    if (!s_win)
+        return 0;
+    *win = s_win;
+    return 1;
+}
+
+typedef struct { VkInstance inst; VkSurfaceKHR *surface; SDL_bool ok; } SurfaceReq;
+
+static void make_surface(void *arg)
+{
+    SurfaceReq *r = (SurfaceReq *)arg;
+    r->ok = SDL_Vulkan_CreateSurface(s_win, r->inst, r->surface);
+#if TARGET_OS_IPHONE
+    if (r->ok)
+        ios_touch_attach(s_win);        /* above the Metal view SDL just added */
+#endif
+}
+
+int nv2a_vk_host_surface(VkInstance inst, VkSurfaceKHR *surface)
+{
+    SurfaceReq r = { inst, surface, SDL_FALSE };
+    if (!s_win)
+        return 0;
+    if (pthread_main_np())
+        make_surface(&r);
+    else
+        dispatch_sync_f(dispatch_get_main_queue(), &r, make_surface);
+    if (!r.ok)
+        fprintf(stderr, "[apple] Vulkan surface: %s\n", SDL_GetError());
+    return r.ok ? 1 : 0;
+}
+#endif
+
+#if defined(NFSU2_METAL)
+#include <SDL_metal.h>
+
+/* nv2a_metal.m: the window's CAMetalLayer, from a Metal view SDL adds on the
+ * main thread (as for the Vulkan surface). */
+static void *s_layer;
+
+static void make_layer(void *arg)
+{
+    SDL_MetalView view;
+    (void)arg;
+    view = SDL_Metal_CreateView(s_win);
+    if (view)
+        s_layer = SDL_Metal_GetLayer(view);
+#if TARGET_OS_IPHONE
+    if (s_layer)
+        ios_touch_attach(s_win);        /* above the Metal view SDL just added */
+#endif
+}
+
+void *nv2a_mtl_host_layer(void)
+{
+    if (!s_win)
+        return NULL;
+    if (pthread_main_np())
+        make_layer(NULL);
+    else
+        dispatch_sync_f(dispatch_get_main_queue(), NULL, make_layer);
+    if (!s_layer)
+        fprintf(stderr, "[apple] Metal view: %s\n", SDL_GetError());
+    return s_layer;
+}
+#endif
+
+#if TARGET_OS_IPHONE
+/* iOS kills an app that submits GPU work from the background (the device
+ * is lost: kIOGPUCommandBufferCallbackErrorBackgroundExecutionNotPermitted).
+ * SDL reports the transitions on the main thread; the renderer's gate holds
+ * its next acquire/submit until the app is in front again.
+ *
+ * The guest itself is paused too, and the sound: a thread of ours takes the
+ * guest lock (kernel_bridge.c) and keeps it while the app is away, so no
+ * guest thread runs -- the main thread must not wait for it itself -- and
+ * the audio device stops. Otherwise the APU kept looping the title's sound
+ * buffers, which nothing refilled, until iOS suspended the app. */
+static pthread_mutex_t s_fg_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  s_fg_cond = PTHREAD_COND_INITIALIZER;
+static int             s_background;
+static int             s_controls_editor;
+
+void xbox_gil_enter(void);              /* kernel_bridge.c: the guest lock */
+void xbox_gil_leave(void);
+void xa2_pause(int on);                 /* apu_xaudio2.c */
+
+static void *pause_thread(void *arg)
+{
+    (void)arg;
+    pthread_mutex_lock(&s_fg_lock);
+    for (;;) {
+        while (!(s_background || s_controls_editor))
+            pthread_cond_wait(&s_fg_cond, &s_fg_lock);
+        pthread_mutex_unlock(&s_fg_lock);
+        xbox_gil_enter();               /* each guest thread stops at its next yield */
+        pthread_mutex_lock(&s_fg_lock);
+        if (s_background || s_controls_editor)
+            fprintf(stderr, "[ios] guest paused\n");
+        while (s_background || s_controls_editor)
+            pthread_cond_wait(&s_fg_cond, &s_fg_lock);
+        pthread_mutex_unlock(&s_fg_lock);
+        xbox_gil_leave();
+        pthread_mutex_lock(&s_fg_lock);
+    }
+    return NULL;
+}
+
+/* Main-thread UI request; pause ownership composes with backgrounding. */
+void ios_controls_editor_pause(int on)
+{
+    pthread_mutex_lock(&s_fg_lock);
+    s_controls_editor = on != 0;
+    int paused = s_background || s_controls_editor;
+    pthread_cond_broadcast(&s_fg_cond);
+    pthread_mutex_unlock(&s_fg_lock);
+    xa2_pause(paused);
+}
+
+static int app_events(void *userdata, SDL_Event *e)
+{
+    (void)userdata;
+    if (e->type == SDL_APP_WILLENTERBACKGROUND || e->type == SDL_APP_DIDENTERFOREGROUND) {
+        pthread_mutex_lock(&s_fg_lock);
+        s_background = e->type == SDL_APP_WILLENTERBACKGROUND;
+        int paused = s_background || s_controls_editor;
+        pthread_cond_broadcast(&s_fg_cond);
+        pthread_mutex_unlock(&s_fg_lock);
+        xa2_pause(paused);
+        fprintf(stderr, "[ios] %s\n", e->type == SDL_APP_WILLENTERBACKGROUND
+                ? "background: GPU work, guest and audio paused" : "foreground");
+    }
+    return 1;
+}
+
+void nv2a_vk_host_gate(void)
+{
+    pthread_mutex_lock(&s_fg_lock);
+    while (s_background || s_controls_editor)
+        pthread_cond_wait(&s_fg_cond, &s_fg_lock);
+    pthread_mutex_unlock(&s_fg_lock);
+}
+
+#if defined(NFSU2_METAL)
+void nv2a_mtl_host_gate(void)
+{
+    nv2a_vk_host_gate();
+}
+#endif
+#endif
+
+static void *game_thread(void *arg)
+{
+    SDL_Event e;
+
+    (void)arg;
+    pthread_setname_np("game");         /* the title's main thread, in [perf] lines */
+    {
+        /* A game thread in the user-interactive class, below audio (apple_qos.c). */
+        extern void xbox_apple_thread_qos(int priority);
+        xbox_apple_thread_qos(0);
+    }
+    s_rc = nfsu2_game_main();
+    SDL_zero(e);
+    e.type = s_done_event;
+    SDL_PushEvent(&e);
+    return NULL;
+}
+
+int main(int argc, char **argv)
+{
+    pthread_attr_t attr;
+    pthread_t th;
+
+    (void)argc;
+    (void)argv;
+#if TARGET_OS_IPHONE
+    ios_host_setup();                   /* paths, settings file, log */
+    SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight");
+    SDL_SetHint(SDL_HINT_IOS_HIDE_HOME_INDICATOR, "2");
+    SDL_SetHint(SDL_HINT_IDLE_TIMER_DISABLED, "1");   /* no auto-lock during movies */
+    SDL_SetHint(SDL_HINT_ACCELEROMETER_AS_JOYSTICK, "0");
+#endif
+    /* Controllers too: macOS delivers their arrival and input through the
+     * main run loop, which only this thread pumps. */
+    if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER) != 0) {
+        fprintf(stderr, "[apple] SDL video: %s\n", SDL_GetError());
+        return 1;
+    }
+#if TARGET_OS_IPHONE
+    SDL_AddEventWatch(app_events, NULL);
+    if (getenv("NFSU2_GAME_DIR"))       /* the user's disc, picked in the app if missing */
+        ios_import_game(getenv("NFSU2_GAME_DIR"));
+    if (getenv("NFSU2_VERIFY") && *getenv("NFSU2_VERIFY") == '1' && getenv("NFSU2_GAME_DIR"))
+        ios_verify_game(getenv("NFSU2_GAME_DIR"));      /* checksums of the disc files */
+#endif
+#if defined(NFSU2_METAL)
+    {
+        /* Metal by default; NFSU2_RENDERER=vulkan keeps MoltenVK. */
+        const char *r = getenv("NFSU2_RENDERER");
+        if (!(r && !strcmp(r, "vulkan"))) {
+            if (__builtin_available(macOS 14.0, iOS 17.0, *))
+                s_metal = 1;
+            else
+                fprintf(stderr, "[apple] the Metal renderer needs macOS 14 / iOS 17\n");
+        }
+        fprintf(stderr, "[apple] renderer: %s\n", s_metal ? "Metal" : "Vulkan (MoltenVK)");
+    }
+#endif
+#if !defined(NFSU2_VULKAN)
+    /* The attributes nv2a_gl.c asks for when it makes the window itself. */
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+    s_win = SDL_CreateWindow("NV2A", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
+                             1280, 720, SDL_WINDOW_OPENGL | SDL_WINDOW_RESIZABLE);
+    if (s_win)
+        s_ctx = SDL_GL_CreateContext(s_win);
+    if (!s_ctx) {
+        fprintf(stderr, "[apple] GL window/context: %s\n", SDL_GetError());
+        return 1;
+    }
+    SDL_GL_MakeCurrent(s_win, NULL);    /* the executor thread takes it */
+#else
+    {
+        const char *h = getenv("RECOMP_VK_HEADLESS");
+        if (!(h && *h == '1')) {
+#if TARGET_OS_IPHONE
+            s_win = SDL_CreateWindow("NFSU2", 0, 0, 0, 0,
+                                     (s_metal ? SDL_WINDOW_METAL : SDL_WINDOW_VULKAN) |
+                                     SDL_WINDOW_FULLSCREEN | SDL_WINDOW_ALLOW_HIGHDPI |
+                                     SDL_WINDOW_BORDERLESS);
+            if (s_win)
+                ios_attach_window_to_scene(s_win);
+#else
+            s_win = SDL_CreateWindow(s_metal ? "NV2A (Metal)" : "NV2A (Vulkan)",
+                                     SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, 1280, 720,
+                                     (s_metal ? SDL_WINDOW_METAL : SDL_WINDOW_VULKAN) |
+                                     SDL_WINDOW_RESIZABLE);
+#endif
+            if (!s_win)
+                fprintf(stderr, "[apple] Vulkan window: %s\n", SDL_GetError());
+        }
+    }
+#endif
+#if !TARGET_OS_IPHONE
+    {
+        const char *e = getenv("NFSU2_FULLSCREEN");
+        if (s_win && !(e && !strcmp(e, "0")))
+            SDL_SetWindowFullscreen(s_win, SDL_WINDOW_FULLSCREEN_DESKTOP);
+    }
+#endif
+    s_done_event = SDL_RegisterEvents(1);
+
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 16u * 1024 * 1024);
+    if (pthread_create(&th, &attr, game_thread, NULL) != 0) {
+        fprintf(stderr, "[FATAL] cannot start the game thread\n");
+        return 1;
+    }
+    pthread_detach(th);
+#if TARGET_OS_IPHONE
+    if (pthread_create(&th, NULL, pause_thread, NULL) == 0)
+        pthread_detach(th);
+#endif
+    pthread_attr_destroy(&attr);
+    apple_perf_start();
+
+#if !TARGET_OS_IPHONE
+    apple_keyboard_controllers_changed();   /* the keyboard as a pad (NFSU2_KEYBOARD=0: off) */
+#endif
+    for (;;) {
+        SDL_Event e;
+#if TARGET_OS_IPHONE
+        int got_event = SDL_WaitEventTimeout(&e, 50);
+        ios_touch_update_auto();
+        if (!got_event) continue;
+#else
+        if (!SDL_WaitEvent(&e)) continue;
+#endif
+        if (e.type == SDL_QUIT) {
+            fprintf(stderr, "[apple] window closed\n");
+            fflush(stdout);
+            fflush(stderr);
+            _exit(0);
+        }
+        if (e.type == s_done_event)
+            return s_rc;
+#if TARGET_OS_IPHONE
+        if (e.type == SDL_JOYDEVICEADDED || e.type == SDL_JOYDEVICEREMOVED)
+            ios_touch_controllers_changed();
+#else
+        if (e.type == SDL_KEYDOWN && e.key.keysym.scancode == SDL_SCANCODE_F11 && !e.key.repeat && s_win)
+            SDL_SetWindowFullscreen(s_win, (SDL_GetWindowFlags(s_win) & SDL_WINDOW_FULLSCREEN_DESKTOP)
+                                           ? 0 : SDL_WINDOW_FULLSCREEN_DESKTOP);
+        apple_keyboard_event(&e);
+        if (e.type == SDL_JOYDEVICEADDED || e.type == SDL_JOYDEVICEREMOVED)
+            apple_keyboard_controllers_changed();
+#endif
+    }
+}
+
+#endif /* __APPLE__ */
diff --git a/src/apple/apple_perf.m b/src/apple/apple_perf.m
new file mode 100644
index 0000000..3a266cc
--- /dev/null
+++ b/src/apple/apple_perf.m
@@ -0,0 +1,216 @@
+/*
+ * apple_perf.m -- a [perf] line every 10 s on Apple hosts (RECOMP_FPS_LOG=1):
+ * the process's CPU time, the busiest threads and the thermal state.
+ *
+ *   [perf] CPU 182% of a core: game 96% p47, 0x1a2b3 41% p31, ...; thermal nominal
+ *   (pN: the thread's scheduling priority, which reflects its QoS class:
+ *    47 user-interactive, 37 user-initiated, 31 default, 20 utility)
+ *
+ *   [perf] APU 1500 frames/s (1500 = real time), frame thread 12% busy
+ *   [perf] APU pacing: ...   (apu_core.c, as in the Switch report)
+ *   [perf] audio out: 0 queue underruns, 0 dropped, 8 of 8 blocks queued
+ *   [perf] APU ring voices: 12 of 9000 samples stale (0.13%)
+ *
+ * Renderers are compared at the same frame rate by this (the title caps
+ * races at 30 fps, so fps alone does not tell them apart), and sound that
+ * breaks up is told apart: the APU behind real time, the game's mixer late
+ * (stale ring samples), or the output queue running dry. Thread times come
+ * from Mach; unnamed threads show their thread ID.
+ */
+#import <Foundation/Foundation.h>
+
+#include <mach/mach.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "apu_xaudio2.h"
+
+int   mcpx_apu_frames_per_second(void);                     /* apu_core.c */
+float mcpx_apu_utilization(void);
+int   mcpx_apu_pacing_stats(char *buf, int cap);
+void  mcpx_apu_ring_stats(uint32_t *stale, uint32_t *total); /* apu_vp.c */
+
+#define PERF_THREADS 256
+#define PERF_TOP     6
+
+typedef struct {
+    uint64_t id;
+    uint64_t us;               /* user + system CPU time at the last sample */
+    uint32_t sample;           /* the last sample that saw the thread */
+} PerfSeen;
+
+static PerfSeen s_seen[PERF_THREADS];
+static uint32_t s_nseen, s_sample;
+
+static uint64_t seen_swap(uint64_t id, uint64_t us)
+{
+    uint32_t i;
+    for (i = 0; i < s_nseen; i++)
+        if (s_seen[i].id == id) {
+            uint64_t prev = s_seen[i].us;
+            s_seen[i].us = us;
+            s_seen[i].sample = s_sample;
+            return prev;
+        }
+    if (s_nseen < PERF_THREADS) {
+        s_seen[s_nseen].id = id;
+        s_seen[s_nseen].us = us;
+        s_seen[s_nseen].sample = s_sample;
+        s_nseen++;
+    }
+    return 0;                   /* new thread: all its time is this window's */
+}
+
+/* Threads that ended since the last sample give their slots back. */
+static void seen_prune(void)
+{
+    uint32_t i, n = 0;
+    for (i = 0; i < s_nseen; i++)
+        if (s_seen[i].sample == s_sample)
+            s_seen[n++] = s_seen[i];
+    s_nseen = n;
+}
+
+static const char *thermal_name(void)
+{
+    switch ([NSProcessInfo processInfo].thermalState) {
+    case NSProcessInfoThermalStateNominal:  return "nominal";
+    case NSProcessInfoThermalStateFair:     return "fair";
+    case NSProcessInfoThermalStateSerious:  return "serious";
+    case NSProcessInfoThermalStateCritical: return "critical";
+    default:                                return "unknown";
+    }
+}
+
+typedef struct {
+    char     name[64];
+    uint64_t us;
+    int      pri;              /* scheduling priority: shows the QoS class */
+} PerfTop;
+
+static void audio_report(void)
+{
+    static uint64_t last_under, last_drop;
+    char pb[256];
+    Xa2Stats st;
+    uint32_t stale, total;
+
+    fprintf(stderr, "[perf] APU %d frames/s (1500 = real time), frame thread %.0f%% busy\n",
+            mcpx_apu_frames_per_second(), mcpx_apu_utilization() * 100.0f);
+    mcpx_apu_pacing_stats(pb, sizeof pb);
+    fprintf(stderr, "[perf] APU pacing: %s\n", pb);
+    if (xa2_is_active()) {
+        xa2_get_stats(&st);
+        fprintf(stderr, "[perf] audio out: %llu queue underruns, %llu dropped, %d of %d blocks"
+                        " queued, peak %d\n", (unsigned long long)(st.underruns - last_under),
+                (unsigned long long)(st.dropped - last_drop), xa2_queued(), xa2_queue_target(),
+                st.peak);
+        last_under = st.underruns;
+        last_drop = st.dropped;
+    }
+    mcpx_apu_ring_stats(&stale, &total);
+    fprintf(stderr, "[perf] APU ring voices: %u of %u samples stale (%u.%02u%%)\n",
+            stale, total, total ? (unsigned)(100ull * stale / total) : 0,
+            total ? (unsigned)(10000ull * stale / total % 100) : 0);
+}
+
+static void sample(double secs, int print)
+{
+    thread_act_array_t th;
+    mach_msg_type_number_t n = 0, i;
+    PerfTop top[PERF_TOP];
+    uint64_t total = 0;
+    uint32_t ntop = 0, k;
+    char line[512];
+    size_t at;
+
+    if (task_threads(mach_task_self(), &th, &n) != KERN_SUCCESS)
+        return;
+    s_sample++;
+    for (i = 0; i < n; i++) {
+        thread_basic_info_data_t bi;
+        thread_identifier_info_data_t ii;
+        thread_extended_info_data_t ei;
+        mach_msg_type_number_t c;
+        uint64_t us, d;
+
+        c = THREAD_BASIC_INFO_COUNT;
+        if (thread_info(th[i], THREAD_BASIC_INFO, (thread_info_t)&bi, &c) != KERN_SUCCESS)
+            goto next;
+        c = THREAD_IDENTIFIER_INFO_COUNT;
+        if (thread_info(th[i], THREAD_IDENTIFIER_INFO, (thread_info_t)&ii, &c) != KERN_SUCCESS)
+            goto next;
+        us = (uint64_t)bi.user_time.seconds * 1000000u + (uint64_t)bi.user_time.microseconds
+           + (uint64_t)bi.system_time.seconds * 1000000u + (uint64_t)bi.system_time.microseconds;
+        d = us - seen_swap(ii.thread_id, us);
+        total += d;
+        if (ntop < PERF_TOP || d > top[ntop - 1].us) {
+            PerfTop t;
+            t.us = d;
+            t.pri = -1;
+            c = THREAD_EXTENDED_INFO_COUNT;
+            if (thread_info(th[i], THREAD_EXTENDED_INFO, (thread_info_t)&ei, &c) == KERN_SUCCESS) {
+                t.pri = ei.pth_priority;
+                if (ei.pth_name[0])
+                    snprintf(t.name, sizeof t.name, "%s", ei.pth_name);
+                else
+                    snprintf(t.name, sizeof t.name, "0x%llx", (unsigned long long)ii.thread_id);
+            } else {
+                snprintf(t.name, sizeof t.name, "0x%llx", (unsigned long long)ii.thread_id);
+            }
+            if (ntop < PERF_TOP)
+                ntop++;
+            for (k = ntop - 1; k > 0 && top[k - 1].us < t.us; k--)
+                top[k] = top[k - 1];
+            top[k] = t;
+        }
+next:
+        mach_port_deallocate(mach_task_self(), th[i]);
+    }
+    vm_deallocate(mach_task_self(), (vm_address_t)th, n * sizeof *th);
+    seen_prune();
+    if (!print)
+        return;
+    at = (size_t)snprintf(line, sizeof line, "[perf] CPU %.0f%% of a core:", total / (secs * 1e4));
+    for (k = 0; k < ntop && at < sizeof line; k++)
+        at += (size_t)snprintf(line + at, sizeof line - at, "%s %s %.0f%% p%d", k ? "," : "",
+                               top[k].name, top[k].us / (secs * 1e4), top[k].pri);
+    if (at < sizeof line)
+        snprintf(line + at, sizeof line - at, "; thermal %s, %u threads", thermal_name(), n);
+    fprintf(stderr, "%s\n", line);
+    audio_report();
+}
+
+static void *perf_thread(void *arg)
+{
+    struct timespec last, now;
+    (void)arg;
+    pthread_setname_np("perf");
+    clock_gettime(CLOCK_MONOTONIC, &last);
+    sample(10.0, 0);                            /* baseline */
+    for (;;) {
+        double dt;
+        struct timespec ts = { 10, 0 };
+        nanosleep(&ts, NULL);
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        dt = (double)(now.tv_sec - last.tv_sec) + (now.tv_nsec - last.tv_nsec) / 1e9;
+        last = now;
+        @autoreleasepool {
+            sample(dt, 1);
+        }
+    }
+    return NULL;
+}
+
+void apple_perf_start(void)
+{
+    const char *e = getenv("RECOMP_FPS_LOG");
+    pthread_t t;
+    if (!(e && *e == '1'))
+        return;
+    if (pthread_create(&t, NULL, perf_thread, NULL) == 0)
+        pthread_detach(t);
+}
