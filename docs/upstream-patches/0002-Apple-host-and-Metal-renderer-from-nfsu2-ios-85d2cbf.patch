 target_include_directories(${PROJECT_NAME} PRIVATE
     ${CMAKE_CURRENT_SOURCE_DIR}/src
@@ -92,8 +114,8 @@ if(WIN32)
 else()
     # The generated chunks are huge straight-line functions; -O1 keeps GCC's
