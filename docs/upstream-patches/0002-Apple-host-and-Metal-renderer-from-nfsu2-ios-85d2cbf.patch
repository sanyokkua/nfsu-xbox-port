diff --git a/cmake/apple_ffmpeg.cmake b/cmake/apple_ffmpeg.cmake
new file mode 100644
index 0000000..5e7c665
--- /dev/null
+++ b/cmake/apple_ffmpeg.cmake
@@ -0,0 +1,35 @@
+# The movie decoder's FFmpeg on Apple targets: dynamic frameworks from
+# tools/build_ffmpeg_apple.sh (LGPL 2.1, only the vp6 decoder), linked and
+# shipped beside the app instead of the static libraries other targets use.
+#   macOS          found through an rpath to NFSU2_FFMPEG_DIR/Frameworks
+#   iOS (Xcode)    embedded and signed by Xcode (XCODE_EMBED_FRAMEWORKS)
+#   iOS (Ninja)    copied into the bundle's Frameworks/ (Simulator builds)
+# The LGPL text goes along in every case.
+set(_nfsu2_ff "${NFSU2_FFMPEG_DIR}/Frameworks")
+target_sources(${PROJECT_NAME} PRIVATE src/movie_vp6.c)
+target_compile_definitions(${PROJECT_NAME} PRIVATE NFSU2_NATIVE_VP6=1)
+target_include_directories(${PROJECT_NAME} BEFORE PRIVATE "${NFSU2_FFMPEG_DIR}/include")
+target_link_libraries(${PROJECT_NAME} PRIVATE
+    "${_nfsu2_ff}/avcodec.framework" "${_nfsu2_ff}/avutil.framework")
+if(NOT IOS)
+    set_property(TARGET ${PROJECT_NAME} APPEND PROPERTY BUILD_RPATH "${_nfsu2_ff}")
+elseif(CMAKE_GENERATOR STREQUAL "Xcode")
+    set_target_properties(${PROJECT_NAME} PROPERTIES
+        XCODE_EMBED_FRAMEWORKS "${_nfsu2_ff}/avcodec.framework;${_nfsu2_ff}/avutil.framework"
+        XCODE_EMBED_FRAMEWORKS_CODE_SIGN_ON_COPY ON
+        XCODE_EMBED_FRAMEWORKS_REMOVE_HEADERS_ON_COPY ON
+        XCODE_ATTRIBUTE_LD_RUNPATH_SEARCH_PATHS "@executable_path/Frameworks")
+    add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E copy "${_nfsu2_ff}/FFmpeg-COPYING.LGPLv2.1"
+                "$<TARGET_BUNDLE_CONTENT_DIR:${PROJECT_NAME}>/FFmpeg-COPYING.LGPLv2.1")
+else()
+    set_property(TARGET ${PROJECT_NAME} APPEND PROPERTY BUILD_RPATH "@executable_path/Frameworks")
+    add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_BUNDLE_CONTENT_DIR:${PROJECT_NAME}>/Frameworks"
+        COMMAND ${CMAKE_COMMAND} -E copy_directory "${_nfsu2_ff}/avcodec.framework"
+                "$<TARGET_BUNDLE_CONTENT_DIR:${PROJECT_NAME}>/Frameworks/avcodec.framework"
+        COMMAND ${CMAKE_COMMAND} -E copy_directory "${_nfsu2_ff}/avutil.framework"
+                "$<TARGET_BUNDLE_CONTENT_DIR:${PROJECT_NAME}>/Frameworks/avutil.framework"
+        COMMAND ${CMAKE_COMMAND} -E copy "${_nfsu2_ff}/FFmpeg-COPYING.LGPLv2.1"
+                "$<TARGET_BUNDLE_CONTENT_DIR:${PROJECT_NAME}>/FFmpeg-COPYING.LGPLv2.1")
+endif()
diff --git a/src/apple/apple_game_state.c b/src/apple/apple_game_state.c
new file mode 100644
index 0000000..7fa7922
--- /dev/null
+++ b/src/apple/apple_game_state.c
@@ -0,0 +1,58 @@
+#include "apple_game_state.h"
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <pthread.h>
+#include <time.h>
+static _Atomic int s_layout = -1;
+static _Atomic(void (*)(void)) s_poll;
+static pthread_once_t s_poll_once = PTHREAD_ONCE_INIT;
+void xbox_gil_enter(void);
+void xbox_gil_leave(void);
+
+static void *poll_thread(void *unused)
+{
+    (void)unused;
+    for (;;) {
+        struct timespec delay = {0, 50000000};
+        nanosleep(&delay, NULL);
+        xbox_gil_enter();
+        void (*poll)(void) = atomic_load_explicit(&s_poll, memory_order_acquire);
+        if (poll) poll();
+        xbox_gil_leave();
+    }
+    return NULL;
+}
+static void start_poll(void)
+{
+    pthread_t thread;
+    if (pthread_create(&thread, NULL, poll_thread, NULL) == 0) pthread_detach(thread);
+}
+void nfsu2_mobile_register_poll(void (*poll)(void))
+{
+    atomic_store_explicit(&s_poll, poll, memory_order_release);
+    pthread_once(&s_poll_once, start_poll);
+}
+
+void nfsu2_mobile_ui_state(uint32_t flow, uint32_t race, uint32_t region, int pause_ui)
+{
+    /* PAL debug enum tables identify GAMEFLOW_STATE_RACING = 6 and
+     * RCSTATE_PAUSE = 6. Race and free-roam controllers keep their pause
+     * state through the options submenus; loading/front-end states use Menu. */
+    int mode = flow == 6 && race != 6 && !pause_ui;
+    static uint32_t last_flow = UINT32_MAX, last_race = UINT32_MAX, last_region = UINT32_MAX;
+    static int last_pause = -1;
+    int changed = flow != last_flow || race != last_race || region != last_region || pause_ui != last_pause;
+    last_flow = flow; last_race = race; last_region = region; last_pause = pause_ui;
+    int old = atomic_exchange_explicit(&s_layout, mode, memory_order_release);
+    if (old != mode || changed)
+        fprintf(stderr, "[controls] auto %s (flow=%u race=%u region=%u pause-ui=%d)\n",
+                mode ? "Drive" : "Menu", flow, race, region, pause_ui);
+}
+
+int nfsu2_mobile_layout_mode(void)
+{
+    const char *e = getenv("NFSU2_AUTO_CONTROLS");
+    if (e && *e == '0') return -1;
+    return atomic_load_explicit(&s_layout, memory_order_acquire);
+}
