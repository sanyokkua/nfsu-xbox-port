diff --git a/xboxrecomp/src/platform/apple_present.h b/xboxrecomp/src/platform/apple_present.h
new file mode 100644
index 0000000..b0ff6ac
--- /dev/null
+++ b/xboxrecomp/src/platform/apple_present.h
@@ -0,0 +1,70 @@
+/* Apple presentation policy shared by Metal and MoltenVK. */
+#ifndef XBOX_APPLE_PRESENT_H
+#define XBOX_APPLE_PRESENT_H
+#include <TargetConditionals.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+static inline uint64_t xbox_apple_present_now(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+}
+
+/* Zero (the default) removes host pacing. An explicit positive cap remains
+ * available without touching the audio or simulation clock. */
+static inline unsigned xbox_apple_present_fps_limit(void)
+{
+    static int limit = -1;
+    if (limit < 0) {
+        const char *e = getenv("NFSU2_FPS_LIMIT");
+        char *end = NULL;
+        long fps = e ? strtol(e, &end, 10) : 0;
+        if (e && (end == e || *end || fps < 0 || fps > 1000)) fps = 0;
+        limit = (int)fps;
+    }
+    return (unsigned)limit;
+}
+
+/* XDK software flip command: low five bits are the operation; bits 5..7
+ * specify the vblank interval and bit 8 selects immediate retirement. Other
+ * bits carry the surface/flags and must be preserved. */
+static inline uint32_t xbox_apple_immediate_flip(uint32_t command)
+{
+    return xbox_apple_present_fps_limit() == 0 && (command & 31u) == 1u
+        ? (command & ~0xE0u) | 0x100u : command;
+}
+
+static inline void xbox_apple_limit_frame(void)
+{
+    static uint64_t last;
+    unsigned fps = xbox_apple_present_fps_limit();
+    if (!fps) return;
+    uint64_t interval = (1000000000ull + fps - 1) / fps;
+    uint64_t now;
+    now = xbox_apple_present_now();
+    while (last && now - last < interval) {
+        uint64_t remain = interval - (now - last);
+        struct timespec t = { (time_t)(remain / 1000000000ull), (long)(remain % 1000000000ull) };
+        if (nanosleep(&t, NULL) != 0 && errno != EINTR) break;
+        now = xbox_apple_present_now();
+    }
+    last = now;
+}
+
+/* Fill uses the entire display without cutting off the HUD. On wider phones
+ * this stretches the 16:9 picture; NFSU2_SCREEN=fit preserves its aspect. */
+static inline int xbox_apple_screen_fill(void)
+{
+    static int fill = -1;
+    if (fill < 0) {
+        const char *e = getenv("NFSU2_SCREEN");
+        fill = e ? !strcmp(e, "fill") : TARGET_OS_IPHONE;
+    }
+    return fill;
+}
+#endif
diff --git a/xboxrecomp/src/platform/apple_qos.c b/xboxrecomp/src/platform/apple_qos.c
new file mode 100644
index 0000000..67bb3b4
--- /dev/null
+++ b/xboxrecomp/src/platform/apple_qos.c
@@ -0,0 +1,58 @@
+/*
+ * apple_qos.c -- Darwin QoS classes for the runtime's and the title's threads.
+ *
+ * A pthread on Darwin starts in the default QoS class (scheduling priority
+ * 31) whatever its creator runs at, and iOS readily moves default-class work
+ * onto the efficiency cores. Measured on macOS: the title's main thread, the
+ * pushbuffer executor and every other worker ran at p31, only system threads
+ * higher. Their work has deadlines -- frames, the EA mixer's refills, its
+ * stream readers -- so they move up:
+ *
+ *   Win32 priority                    QoS class            relative priority
+ *   above normal .. time critical     user-interactive     0   (the APU frame
+ *                                                               thread, the EA mixer)
+ *   normal                            user-interactive    -1   (game threads)
+ *   below normal, lowest              user-initiated       0
+ *   idle                              utility              0
+ *
+ * so audio stays above the game threads, as CLAUDE.md asks. Only a thread's
+ * own QoS can be set: win32_compat.c calls this on the thread, when it starts
+ * (with the priority it was created with or given while suspended) and when
+ * it changes its own priority; a change made from another thread waits for
+ * neither (rare: the title sets priorities before resuming a thread).
+ * RECOMP_QOS=0 leaves every thread in the default class.
+ */
+#if defined(__APPLE__)
+
+#include <pthread.h>
+#include <pthread/qos.h>
+#include <stdlib.h>
+
+#include "win32_compat.h"
+
+void xbox_apple_thread_qos(int priority)
+{
+    static int on = -1;
+    qos_class_t cls;
+    int rel = 0;
+
+    if (on < 0) {
+        const char *e = getenv("RECOMP_QOS");
+        on = !(e && *e == '0');
+    }
+    if (!on)
+        return;
+    if (priority >= THREAD_PRIORITY_ABOVE_NORMAL) {
+        cls = QOS_CLASS_USER_INTERACTIVE;
+    } else if (priority == THREAD_PRIORITY_NORMAL) {
+        cls = QOS_CLASS_USER_INTERACTIVE;
+        rel = -1;
+    } else if (priority > THREAD_PRIORITY_IDLE) {
+        cls = QOS_CLASS_USER_INITIATED;
+    } else {
+        cls = QOS_CLASS_UTILITY;
+    }
+    pthread_set_qos_class_self_np(cls, rel);
+}
+
+#endif /* __APPLE__ */
